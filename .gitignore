# ============================================================
# FerreSys - .gitignore
# Proyecto: Flask + MySQL + uv (Astral)
# ============================================================

# --------------------------
# Entorno virtual (uv / venv)
# --------------------------
.venv/
venv/
env/
ENV/
.uv/
uv.lock

# --------------------------
# Variables de entorno / secretos
# --------------------------
.env
.env.*
!.env.example
*.env

# --------------------------
# Python
# --------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg
*.egg

# --------------------------
# Flask / logs
# --------------------------
instance/
*.log
flask_session/
*.pid
*.seed

# --------------------------
# Base de datos (dumps locales)
# --------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
dump.sql
backup.sql

# --------------------------
# Testing / cobertura
# --------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --------------------------
# Editores / IDE
# --------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject
.settings/

# --------------------------
# Sistema operativo
# --------------------------
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# --------------------------
# Jupyter (por si acaso)
# --------------------------
.ipynb_checkpoints/

# --------------------------
# Archivos temporales
# --------------------------
*.tmp
*.bak
*.orig
*.rej