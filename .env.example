# ============================================================
# FerreSys - Variables de Entorno (Plantilla)
# Copia este archivo, renómbralo a .env y rellena los valores.
# ============================================================

# Clave secreta para la seguridad de Flask (sesiones, flash messages, etc.)
# Puedes generar una nueva usando: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esta_clave_por_una_segura

# Configuración de la Base de Datos MySQL
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=tu_contraseña_aqui
MYSQL_DB=ferresys_db
MYSQL_PORT=3306